# Public address. Point this domain's A/AAAA records to the VPS before starting Caddy.
DOMAIN=pos.example.com
APP_NAME="POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pos.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=pos
DB_USERNAME=pos
DB_PASSWORD=replace-with-a-long-unique-password
MARIADB_ROOT_PASSWORD=replace-with-a-different-long-unique-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Set these if real-time Pusher notifications are enabled.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@pos.example.com"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"
