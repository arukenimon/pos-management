{
  "name": "pos-showcase-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts --port=3100",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/create-audio-upbeat.mjs",
    "music": "npm run assets && node scripts/replace-music.mjs && npm run verify",
    "render": "npm run assets && remotion render src/index.ts PosShowcase out/pos-showcase.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --color-space=bt709 --image-format=png --concurrency=4",
    "poster": "remotion still src/index.ts PosShowcase out/pos-showcase-poster.png --frame=55",
    "verify": "node scripts/verify-render.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@remotion/bundler": "4.0.538",
    "@remotion/cli": "4.0.538",
    "@remotion/renderer": "4.0.538",
    "lucide-react": "0.561.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "typescript": "5.9.3"
  }
}
